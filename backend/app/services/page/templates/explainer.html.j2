<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <style>
    :root { --bg:#FFF9D6; --ink:#2A2618; --head:#16325C; --tldr:#FFEFA6; --amber:#E0A100; --note:#4A4532; }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--bg); color:var(--ink);
           font: 19px/1.75 "Atkinson Hyperlegible", system-ui, sans-serif;
           word-spacing:.08em; letter-spacing:.01em; }
    main { max-width:1100px; margin:0 auto; padding:48px 24px 80px; }
    h1 { color:var(--head); font-size:1.9rem; line-height:1.25; margin:0 0 24px; }
    h2 { color:var(--head); font-size:1.4rem; line-height:1.3; margin:56px 0 16px; }
    p  { margin:0 0 1.1em; max-width:68ch; }
    .tldr { background:var(--tldr); border-left:4px solid var(--amber);
            padding:16px 20px; border-radius:8px; max-width:68ch; }
    .cols { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);
            gap:40px; align-items:start; }
    .visual { background:#fff; border-radius:12px; padding:16px;
              box-shadow:0 2px 10px rgba(42,38,24,.12); margin-bottom:16px; }
    .visual-wide { max-width:1000px; margin:20px auto 16px; }
    .visual img { width:100%; height:auto; display:block; }
    table { border-collapse:collapse; width:100%; font-size:.95em; }
    th, td { border:1px solid #E6DDA8; padding:8px 10px; text-align:left; vertical-align:top; }
    th { background:var(--tldr); color:var(--head); }
    pre { background:#fff; padding:14px; border-radius:8px; overflow-x:auto; font-size:.85em; }
    blockquote { margin:0 0 1.1em; padding-left:16px; border-left:3px solid var(--amber); }
    .notes { margin-top:12px; padding-left:14px; border-left:2px solid var(--amber); max-width:68ch; }
    .notes .label { font-size:.8em; text-transform:uppercase; letter-spacing:.06em; color:var(--note); }
    .note { font-style:italic; color:var(--note); margin:4px 0; }
    .note a { color:var(--head); }
    .takeaways li { margin-bottom:.6em; }
    @media (max-width:760px) {
      body { font-size:18px; }
      main { padding:28px 16px 56px; }
      .cols { grid-template-columns:1fr; gap:16px; }
    }
  </style>
</head>
<body>
<main>
  <h1>{{ title }}</h1>
  <p class="tldr"><strong>TL;DR:</strong> {{ tldr }}</p>

  {% for s in sections %}
  <section id="{{ s.id }}">
    <h2>{{ s.heading }}</h2>

    {% if s.mode == "simplified_visual" %}
    {% macro figs(vs) %}{% for v in vs %}
        <figure class="visual{% if v.wide %} visual-wide{% endif %}">
          {% if v.kind == "table" %}
          <table>
            <tr>{% for c in v.columns %}<th>{{ c }}</th>{% endfor %}</tr>
            {% for row in v.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}
          </table>
          {% else %}
          <img src="{{ v.url }}" alt="{{ v.alt }}" loading="lazy">
          {% endif %}
        </figure>
    {% endfor %}{% endmacro %}
    {% if s.wide %}
    <div class="text">{{ s.body_html }}</div>
    <div class="visuals">{{ figs(s.visuals) }}</div>
    {% else %}
    <div class="cols">
      <div class="text">{{ s.body_html }}</div>
      <div class="visuals">{{ figs(s.visuals) }}</div>
    </div>
    {% endif %}
    {% else %}
    <div class="text">{{ s.body_html }}</div>
    {% endif %}

    {% if s.notes %}
    <div class="notes">
      <div class="label">Added explanation</div>
      {% for n in s.notes %}
      <p class="note"><strong>{{ n.term }}</strong> — {{ n.definition }}{% if n.source_url %} (<a href="{{ n.source_url }}">source</a>){% endif %}</p>
      {% endfor %}
    </div>
    {% endif %}
  </section>
  {% endfor %}

  <section class="takeaways">
    <h2>Key takeaways</h2>
    <ul>{% for t in takeaways %}<li>{{ t }}</li>{% endfor %}</ul>
  </section>
</main>
</body>
</html>
