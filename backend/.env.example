# Neon: pooled URL for the app, direct URL for schema.sql. Both need sslmode=require.
VELMA_DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
VELMA_DATABASE_DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Limits (defaults shown)
# Folder for per-job working files (the Docker compose file overrides it with /scratch).
VELMA_SCRATCH_DIR=./scratch
VELMA_MAX_ARTICLE_CHARS=2000000
VELMA_MAX_CONCURRENT_JOBS=5
VELMA_MAX_JOB_SECONDS=1800
VELMA_MAX_HTML_BYTES=1000000
VELMA_RETRY_PAUSE_SECONDS=120

# Storage: Neon object storage (S3-compatible, path-style addressing).
# Archive bucket is private (inputs, state); CDN bucket is public_read (pages).
# CDN base URL is <endpoint>/<cdn-bucket>.
VELMA_S3_ENDPOINT_URL=https://objectstorage.region.aws.neon.tech
VELMA_ARCHIVE_BUCKET=velma-archive
VELMA_CDN_BUCKET=velma-cdn
VELMA_CDN_BASE_URL=https://objectstorage.region.aws.neon.tech/velma-cdn
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_REGION=region
AWS_DEFAULT_REGION=region

# LLM and tools
VELMA_GEMINI_API_KEY=changeme
VELMA_TAVILY_API_KEY=changeme

# Agent
# Agent steps (model turns) allowed per job; raise for very long articles.
VELMA_MAX_STEPS=60
# Token budget per job = min(BASE + PER_WORD x article words, MAX); raise if long jobs stop on "limit".
VELMA_TOKEN_BUDGET_BASE=150000
VELMA_TOKEN_BUDGET_PER_WORD=30
VELMA_TOKEN_BUDGET_MAX=2000000
# Plain-text agent replies tolerated (each gets a reminder to call a tool) before the job gives up; 0 or more.
VELMA_MAX_NUDGES=1
# Characters of one tool result sent back to the agent; lower saves tokens, raise if results get cut.
VELMA_MAX_TOOL_RESULT_CHARS=4000

# Outline
# Max words per outline chunk; articles up to this size need one model call. Lower if outline replies get cut off.
VELMA_OUTLINE_CHUNK_WORDS=10000
# Share (0-1) of a chunk, counted from its end, searched for the best place to cut; raise for better cuts in messy text.
VELMA_OUTLINE_CUT_SEARCH=0.2
# Output token cap for the outline model call; must fit the facts of a whole chunk and stay under the model's limit.
VELMA_OUTLINE_MAX_OUTPUT_TOKENS=32768

# Diagrams
# Share (0-1) of sections that get a diagram; 1.0 tries every section above the minimum score, 0 draws only the minimum.
VELMA_DIAGRAM_RATIO=0.6
# Lowest visual_score (0-10) a section may have and still be drawn; raise for fewer, more useful diagrams.
VELMA_DIAGRAM_MIN_SCORE=4
# Diagrams per article: at least this many (if any section qualifies) and at most this many.
VELMA_DIAGRAM_MIN_PER_ARTICLE=1
VELMA_DIAGRAM_MAX_PER_ARTICLE=12
# Render attempts per diagram inside draw before the failure is recorded.
VELMA_DIAGRAM_RENDER_TRIES=3

# Rewrite
# Rewrite length as a multiple of the original's prose words: allowed range and the aim given to the model.
VELMA_REWRITE_LENGTH_MIN=0.7
VELMA_REWRITE_LENGTH_MAX=1.1
VELMA_REWRITE_LENGTH_TARGET=0.9
# Flesch-Kincaid reading grade ceiling. 10 suits technical articles: long terms like "authorization" add grade on their own.
VELMA_REWRITE_MAX_GRADE=10
# Running text shorter than this many words skips the reading-grade rule (the formula is noise on 2-3 sentences).
VELMA_REWRITE_MIN_WORDS_FOR_GRADE=40
# Rewrite + check rounds per section. After the last round: lost facts -> the original text is shown;
# only style misses (length, grade) -> the rewrite is kept. 1 or more.
VELMA_REWRITE_MAX_ROUNDS=2

# Check
# Folder with the NLI model files (model.onnx, tokenizer.json, config.json); fetched by scripts/fetch_nli.py. Default: backend/models/nli.
# VELMA_CHECK_NLI_DIR=models/nli
# lenient | normal | strict: sets the thresholds below together. Any value set below overrides the preset.
VELMA_CHECK_STRICTNESS=normal
# Presets (lenient/normal/strict) fill these when left unset; uncomment to override one.
# NLI entailment (0-1) needed to count a fact as kept (0.45 / 0.60 / 0.75).
# VELMA_CHECK_ENTAIL_MIN=0.60
# NLI contradiction (0-1) that counts as "meaning shifted"; lower is stricter (0.70 / 0.50 / 0.35).
# VELMA_CHECK_CONTRA_MIN=0.50
# true = a number (or name) from the fact missing in the rewrite fails the fact (false / true / true).
# VELMA_CHECK_EXACT_NUMBERS=true
# VELMA_CHECK_EXACT_NAMES=true
# Share (0-1) of facts that must be kept for check to pass (0.8 / 1.0 / 1.0).
# VELMA_CHECK_MIN_KEPT_RATIO=1.0
# BM25 candidate sentences per fact (3 / 3 / 5).
# VELMA_CHECK_TOP_K=3
# At or below this many sentences every sentence is scored and BM25 is skipped (6 / 6 / 12).
# VELMA_CHECK_ALL_PAIRS_MAX_SENTENCES=6
# BM25 term saturation and length normalisation; rarely changed.
# VELMA_CHECK_BM25_K1=1.2
# VELMA_CHECK_BM25_B=0.75
# Facts about code or tables: exact = number/name check only, nli = also NLI (exact / exact / nli).
# VELMA_CHECK_CODE_TABLE_FACTS=exact

# Terms
# true = explain_term refuses a term without web_search results; false = unsourced definitions are normal.
VELMA_EXPLAIN_REQUIRE_SOURCE=true
# Tavily results kept per term, and characters kept per result snippet.
VELMA_SEARCH_RESULTS_PER_TERM=3
VELMA_SEARCH_SNIPPET_CHARS=300
# Definition length cap in sentences.
VELMA_EXPLAIN_MAX_SENTENCES=2

# Optional: Arize Phoenix tracing. Unset = tracing off.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
